# Copy to .env. pydantic-settings reads .env for `uv run savetube ...`; `make`
# sources it for the tests. Single-quote every URL: an unquoted `&` splits the
# line into a background command when the shell sources it.

# Postgres DSN: the shared dev server, role `savetube`. Password: 1Password item
# `savetube-dev-db`, field `password`:
#   op read 'op://Homelab/savetube-dev-db/password'
# sslrootcert takes an absolute path, `~` is not expanded. Fetch the CA with:
#   kubectl -n postgres-dev get secret postgres-dev-ca -o jsonpath='{.data.ca\.crt}' | base64 -d > ~/.postgresql/postgres-dev-ca.crt
# The CA rotates every 90 days and on a cluster recreate: fetch it again when
# connections fail certificate verification.
SAVETUBE_DATABASE_URL='postgres://savetube:<password>@pg-dev.lab.hiriri.com:5432/savetube?sslmode=verify-full&sslrootcert=/Users/<you>/.postgresql/postgres-dev-ca.crt'

# Admin URL for the DB-gated tests. Each run creates and drops its own database,
# savetube_test, so the role needs CREATEDB. `make check` fails when it is unset;
# a bare `uv run pytest` skips those tests and looks green.
SAVETUBE_TEST_DATABASE_URL='postgres://savetube:<password>@pg-dev.lab.hiriri.com:5432/savetube?sslmode=verify-full&sslrootcert=/Users/<you>/.postgresql/postgres-dev-ca.crt'

# `openssl rand -base64 32`. Signs the session cookie; rotating it logs everyone out.
SAVETUBE_SESSION_SECRET=

# A Zitadel application whose redirect URI is http://127.0.0.1:8000/auth/callback.
# A Web application rejects an http:// redirect URI, so a local one is Native with PKCE.
SAVETUBE_OIDC_CLIENT_ID=
SAVETUBE_OIDC_REQUIRED_GROUP=savetube-admin
SAVETUBE_PUBLIC_URL=http://127.0.0.1:8000

SAVETUBE_ARCHIVE_ROOT=./archive-dev
